{
  "name": "zstack",
  "version": "0.1.0",
  "description": "Agent Operating System for Rigorous Engineering powered by ModelHitch",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    }
  },
  "bin": {
    "zstack": "bin/zstack.mjs"
  },
  "scripts": {
    "status": "node bin/zstack.mjs status",
    "sync": "node bin/zstack.mjs sync",
    "test": "node tests/connector.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:live": "node scripts/verify.mjs --live"
  },
  "keywords": [
    "ai",
    "agents",
    "modelhitch",
    "opencode",
    "verification",
    "playbooks"
  ],
  "author": "genoventures-labs",
  "license": "MIT"
}
